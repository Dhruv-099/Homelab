### Example environment variables for this homelab
# Copy this to `.env` and fill values. DO NOT commit `.env` to GitHub.

# Forgejo
FORGEJO_DB_PASSWORD=change_me
FORGEJO_DATA_DIR=./forgejo
FORGEJO_PGDATA_DIR=./postgres
FORGEJO_ROOT_URL=https://git.example.com

# Nextcloud
NEXTCLOUD_DB_PASSWORD=change_me
NEXTCLOUD_ADMIN_PASSWORD=change_me
NEXTCLOUD_TRUSTED_DOMAIN=cloud.example.com
NEXTCLOUD_DATA_DIR=./nextcloud_data

# Vaultwarden
VAULTWARDEN_ADMIN_TOKEN=change_me
VAULTWARDEN_DOMAIN=https://vault.example.com
VAULTWARDEN_DATA_DIR=./vaultwarden

# Host user that owns the media drive (run `id` on the host)
PUID=1000
PGID=1000

# Media libraries (shared)
MEDIA_DIR=./media
NAVIDROME_MUSIC_DIR=./music

# Kavita
KAVITA_BOOKS_DIR=./books

# Immich (already uses env vars)
DB_PASSWORD=change_me
DB_USERNAME=immich
DB_DATABASE_NAME=immich
DB_DATA_LOCATION=./immich_db
UPLOAD_LOCATION=./immich_uploads

# Notifier (Telegram alerts via Beszel + Watchtower)
TELEGRAM_BOT_TOKEN=change_me
TELEGRAM_CHAT_ID=change_me
BESZEL_URL=http://beszel:8090
BESZEL_EMAIL=change_me
BESZEL_PASSWORD=change_me
# Beszel agent (from Beszel → Add System)
BESZEL_AGENT_KEY=ssh-ed25519 change_me
BESZEL_AGENT_TOKEN=change_me
# Data drives monitored by the Beszel agent (mount path + block device, see `lsblk`)
MEDIA_DRIVE_MOUNT=/mnt/media
MEDIA_DRIVE_DEVICE=sdc1
STORAGE_DRIVE_MOUNT=/mnt/storage
STORAGE_DRIVE_DEVICE=sdb1
MEDIA_DRIVE_LABEL=Media
STORAGE_DRIVE_LABEL=Storage
# Label for the host/root disk in notifier messages
ROOT_DISK_LABEL=Root

# Watchtower (update reports posted to the notifier's webhook)
WATCHTOWER_NOTIFICATION_URL=generic+http://homelab-inbox:8000/watchtower?template=json

# Bookstack
BOOKSTACK_APP_URL=https://wiki.example.com
BOOKSTACK_DB_PASSWORD=change_me
BOOKSTACK_APP_KEY=change_me

# Vikunja
VIKUNJA_PUBLIC_URL=https://tasks.example.com
VIKUNJA_DB_PASSWORD=change_me
VIKUNJA_SERVICE_SECRET=change_me